<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    tools:ignore="UselessParent">

    <!-- La burbuja se pone a la derecha si el mensaje es mío y a la izquierda si no -->
    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Nombre" />

        <!-- Solo se muestra si el mensaje es una imagen -->
        <ImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/image_message"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            tools:text="Hola, ¿cómo estás?" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            tools:text="05/10/2026 21:30" />

    </LinearLayout>

</LinearLayout>
